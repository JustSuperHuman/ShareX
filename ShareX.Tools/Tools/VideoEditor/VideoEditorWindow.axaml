<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShareX.Tools"
        xmlns:controls="using:ShareX.Tools.Controls"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="ShareX.Tools.VideoEditorWindow"
        x:DataType="vm:VideoEditorViewModel"
        Title="ShareX - Video Editor"
        Width="1050"
        Height="720"
        MinWidth="850"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.section-heading">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.path-text">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
    </Window.Styles>

    <ThemeVariantScope RequestedThemeVariant="{x:Static theming:ThemeManager.ShareXDark}">
        <Grid Background="{DynamicResource ShareX.Brush.Background.Main}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
                <Border Grid.Row="0" Classes="tool-panel" Padding="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Classes="section-heading" Text="Recording" Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Classes="path-text" Text="{Binding InputFileDisplay}"/>
                            <TextBlock Classes="path-text" Text="{Binding SourceInfoText}" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseInputCommand}" IsEnabled="{Binding IsIdle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="tool-panel" Padding="12">
                        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="10">
                            <Border Grid.Row="0" Background="Black" CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <controls:VideoCropControl PreviewImage="{Binding PreviewImage}"
                                                               SourceWidth="{Binding SourceWidth}"
                                                               SourceHeight="{Binding SourceHeight}"
                                                               CropRect="{Binding CropRect, Mode=TwoWay}"
                                                               CameraRect="{Binding CameraRect}"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoPreview}">
                                        <TextBlock Text="{x:Static theming:LucideIcons.file_video}" Classes="icon" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Choose a recording to preview it" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0" Classes="compact" Command="{Binding StepBackwardCommand}" ToolTip.Tip="Previous frame (Left)">
                                    <TextBlock Text="{x:Static theming:LucideIcons.skip_back}" Classes="icon"/>
                                </Button>
                                <Panel Grid.Column="1">
                                    <Button Classes="compact" Command="{Binding TogglePlaybackCommand}" IsVisible="{Binding !IsPlaying}" ToolTip.Tip="Play (Space)">
                                        <TextBlock Text="{x:Static theming:LucideIcons.play}" Classes="icon"/>
                                    </Button>
                                    <Button Classes="compact" Command="{Binding TogglePlaybackCommand}" IsVisible="{Binding IsPlaying}" ToolTip.Tip="Pause (Space)">
                                        <TextBlock Text="{x:Static theming:LucideIcons.pause}" Classes="icon"/>
                                    </Button>
                                </Panel>
                                <Button Grid.Column="2" Classes="compact" Command="{Binding StepForwardCommand}" ToolTip.Tip="Next frame (Right)">
                                    <TextBlock Text="{x:Static theming:LucideIcons.skip_forward}" Classes="icon"/>
                                </Button>
                                <TextBlock Grid.Column="3" Text="{Binding PreviewTimeText}" FontFamily="{DynamicResource ShareX.FontFamily.Monospace}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Speed" Classes="field-label" VerticalAlignment="Center" Margin="0"/>
                                <ComboBox Grid.Column="5" ItemsSource="{x:Static vm:VideoEditorViewModel.PlaybackSpeeds}" SelectedItem="{Binding SelectedPlaybackSpeed}" VerticalAlignment="Center" MinWidth="64"/>
                            </Grid>

                            <controls:VideoTimelineControl Grid.Row="2"
                                                           Duration="{Binding Duration}"
                                                           InPoint="{Binding InPoint, Mode=TwoWay}"
                                                           OutPoint="{Binding OutPoint, Mode=TwoWay}"
                                                           Position="{Binding PreviewPosition, Mode=TwoWay}"
                                                           ZoomRegions="{Binding ZoomRegions}"
                                                           SpeedSegments="{Binding SpeedBands}"
                                                           ClickMarkers="{Binding ClickMarkers}"
                                                           SelectedSegment="{Binding SelectedSegmentIndex, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border Classes="tool-panel" Padding="14">
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{x:Static theming:LucideIcons.sparkles}" Classes="icon" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Classes="section-heading" Text="Auto-zoom" Margin="0" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding AutoZoomEnabled}" IsEnabled="{Binding AutoZoomAvailable}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel IsVisible="{Binding AutoZoomAvailable}">
                                        <TextBlock Text="Glides and zooms to follow your cursor and clicks." Classes="field-label" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                            <TextBlock Grid.Column="0" Classes="field-label" Text="Zoom amount" Margin="0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AutoZoomAmount, StringFormat={}{0:0.0}×}" Classes="field-label" Margin="0"/>
                                        </Grid>
                                        <Slider Minimum="1.2" Maximum="3.0" Value="{Binding AutoZoomAmount}" IsEnabled="{Binding AutoZoomEnabled}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                        <TextBlock Classes="field-label" Text="Smoothness" Margin="0,4,0,0"/>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding AutoZoomSmoothness}" IsEnabled="{Binding AutoZoomEnabled}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock Text="{Binding AutoZoomStatusText}" Foreground="{DynamicResource ShareX.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock IsVisible="{Binding !AutoZoomAvailable}" Text="No motion track was recorded with this video. Record with mouse tracking enabled to unlock auto-zoom." Classes="field-label" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="tool-panel" Padding="14">
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="{x:Static theming:LucideIcons.gauge}" Classes="icon" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Classes="section-heading" Text="Clips" Margin="0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Classes="compact" Command="{Binding UndoSegmentEditCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo last clip change (Ctrl+Z)">
                                            <TextBlock Text="{x:Static theming:LucideIcons.undo}" Classes="icon"/>
                                        </Button>
                                        <Button Grid.Column="3" Classes="compact" Command="{Binding ResetSpeedsCommand}" ToolTip.Tip="Clear all speed and cut changes">
                                            <TextBlock Text="{x:Static theming:LucideIcons.undo_2}" Classes="icon"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Split the recording at the playhead, then speed up or cut each clip." Classes="field-label" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,10,0,0">
                                        <Button Grid.Column="0" Command="{Binding SplitAtPlayheadCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Split at playhead (S)">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Static theming:LucideIcons.split}" Classes="icon"/>
                                                <TextBlock Text="Split"/>
                                            </StackPanel>
                                        </Button>
                                        <Panel Grid.Column="1">
                                            <Button Command="{Binding ToggleRemoveSegmentCommand}" IsVisible="{Binding !SelectedSegmentRemoved}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Cut the highlighted clip out of the video (Delete)">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Static theming:LucideIcons.scissors}" Classes="icon"/>
                                                    <TextBlock Text="Cut clip"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ToggleRemoveSegmentCommand}" IsVisible="{Binding SelectedSegmentRemoved}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Put the cut clip back (Delete)">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Static theming:LucideIcons.redo}" Classes="icon"/>
                                                    <TextBlock Text="Restore clip"/>
                                                </StackPanel>
                                            </Button>
                                        </Panel>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedSegmentText}" Foreground="{DynamicResource ShareX.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,6" FontSize="11"/>
                                    <UniformGrid Columns="3" Rows="2">
                                        <Button Classes="compact" Content="0.25×" Command="{Binding SetSegmentSpeedCommand}" CommandParameter="0.25" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <Button Classes="compact" Content="0.5×" Command="{Binding SetSegmentSpeedCommand}" CommandParameter="0.5" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <Button Classes="compact" Content="1×" Command="{Binding SetSegmentSpeedCommand}" CommandParameter="1" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <Button Classes="compact" Content="1.5×" Command="{Binding SetSegmentSpeedCommand}" CommandParameter="1.5" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <Button Classes="compact" Content="2×" Command="{Binding SetSegmentSpeedCommand}" CommandParameter="2" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        <Button Classes="compact" Content="4×" Command="{Binding SetSegmentSpeedCommand}" CommandParameter="4" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding SpeedSummaryText}" Foreground="{DynamicResource ShareX.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>

                                    <StackPanel IsVisible="{Binding HasMotionData}">
                                        <Separator Margin="0,12,0,10"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{x:Static theming:LucideIcons.mouse_pointer_click}" Classes="icon" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Idle moments" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding IdleThresholdText}" Classes="field-label" Margin="0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Uses the recorded mouse activity to find stretches where nothing happened." Classes="field-label" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <Slider Minimum="1" Maximum="6" Value="{Binding IdleThresholdSeconds}" TickFrequency="0.5" IsSnapToTickEnabled="True" ToolTip.Tip="How long the mouse must stay still to count as idle"/>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button Grid.Column="0" Command="{Binding FastForwardIdleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Play idle stretches at 4× instead of cutting them">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Static theming:LucideIcons.fast_forward}" Classes="icon"/>
                                                    <TextBlock Text="Speed up"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Command="{Binding CutIdleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Cut idle stretches out of the video entirely">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Static theming:LucideIcons.scissors}" Classes="icon"/>
                                                    <TextBlock Text="Cut out"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="tool-panel" Padding="14">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="section-heading" Text="Trim"/>
                                        <Button Grid.Column="1" Classes="compact" Command="{Binding ResetTrimCommand}" ToolTip.Tip="Reset trim">
                                            <TextBlock Text="{x:Static theming:LucideIcons.undo_2}" Classes="icon"/>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Classes="field-label" Text="Start"/>
                                            <TextBox Text="{Binding StartTimeText}" FontFamily="{DynamicResource ShareX.FontFamily.Monospace}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="field-label" Text="End"/>
                                            <TextBox Text="{Binding EndTimeText}" FontFamily="{DynamicResource ShareX.FontFamily.Monospace}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,10,0,0">
                                        <Button Grid.Column="0" Content="Set start" Command="{Binding SetStartCommand}" ToolTip.Tip="Trim the start to the playhead (I)"/>
                                        <Button Grid.Column="1" Content="Set end" Command="{Binding SetEndCommand}" ToolTip.Tip="Trim the end to the playhead (O)"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectionDurationText, StringFormat=Selected: {0}}" Foreground="{DynamicResource ShareX.Brush.Text.Secondary}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="tool-panel" Padding="14">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="section-heading" Text="Crop"/>
                                        <Button Grid.Column="1" Classes="compact" Command="{Binding ResetCropCommand}" ToolTip.Tip="Reset crop">
                                            <TextBlock Text="{x:Static theming:LucideIcons.undo_2}" Classes="icon"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Classes="field-label" Text="Aspect ratio"/>
                                    <ComboBox ItemsSource="{x:Static vm:VideoEditorViewModel.CropAspects}" SelectedItem="{Binding SelectedCropAspect}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VideoCropAspectItem">
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,12,0,0">
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Classes="field-label" Text="X"/>
                                            <NumericUpDown Value="{Binding CropX}" Minimum="0" Maximum="{Binding CropMaximumX}" Increment="2" FormatString="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Classes="field-label" Text="Y"/>
                                            <NumericUpDown Value="{Binding CropY}" Minimum="0" Maximum="{Binding CropMaximumY}" Increment="2" FormatString="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Classes="field-label" Text="Width"/>
                                            <NumericUpDown Value="{Binding CropWidth}" Minimum="2" Maximum="{Binding CropMaximumWidth}" Increment="2" FormatString="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Classes="field-label" Text="Height"/>
                                            <NumericUpDown Value="{Binding CropHeight}" Minimum="2" Maximum="{Binding CropMaximumHeight}" Increment="2" FormatString="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding CropSizeText, StringFormat=Output frame: {0}}" Foreground="{DynamicResource ShareX.Brush.Text.Secondary}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Classes="tool-panel" Padding="12">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="field-label" Text="Save as"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" Text="{Binding OutputFileName}" PlaceholderText="recording-edited.mp4" IsEnabled="{Binding IsIdle}"/>
                                    <Button Grid.Column="1" Command="{Binding BrowseOutputFolderCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Choose output folder">
                                        <TextBlock Text="{x:Static theming:LucideIcons.folder_open}" Classes="icon"/>
                                    </Button>
                                </Grid>
                                <TextBlock Classes="path-text" Text="{Binding OutputFilePath}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="field-label" Text="Size"/>
                                <ComboBox ItemsSource="{x:Static vm:VideoEditorViewModel.ExportSizes}" SelectedItem="{Binding SelectedExportSize}" IsEnabled="{Binding IsIdle}" MinWidth="118">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VideoExportSizeItem">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="field-label" Text="Quality"/>
                                <ComboBox ItemsSource="{x:Static vm:VideoEditorViewModel.ExportQualities}" SelectedItem="{Binding SelectedExportQuality}" IsEnabled="{Binding IsIdle}" MinWidth="112">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VideoExportQualityItem">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Grid.Column="3" IsChecked="{Binding AutoOpenFolder}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center">
                                <TextBlock Text="Open folder when finished" FontWeight="Normal"/>
                            </CheckBox>
                        </Grid>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" IsVisible="{Binding IsBusy}"/>
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ExportCommand}" IsVisible="{Binding IsIdle}" IsEnabled="{Binding CanExport}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Static theming:LucideIcons.save}" Classes="icon"/>
                                    <TextBlock Text="Export video"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Static theming:LucideIcons.square_stop}" Classes="icon"/>
                                    <TextBlock Text="Stop"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ThemeVariantScope>
</Window>
